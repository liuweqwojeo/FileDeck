+def copy_pinned_plugin_entries(out_dir):
+  # 入口文件来自项目已固定提交的仓库，不能再使用随网站发布变化的 URL。
+  source_dir = get_script_dir() + "/../../onlyoffice.github.io/sdkjs-plugins/v1"
+  names = ("plugins.js", "plugins-ui.js", "plugins.css")
+  # 先验证全部输入，避免缺失一个文件时留下混合版本；复制失败必须向上传播。
+  for name in names:
+    if not is_file(source_dir + "/" + name):
+      raise RuntimeError("固定的插件入口文件缺失：" + source_dir + "/" + name)
+  os.makedirs(get_path(out_dir), exist_ok=True)
+  for name in names:
+    shutil.copy2(get_path(source_dir + "/" + name), get_path(out_dir + "/" + name))
+  return
