+/// 工作台品牌从最终应用元数据读取；只替换主窗口标识，编辑内核及第三方声明保持原样。
+static NSImage *FWTitleBrandImage(BOOL dark) {
+#if FW_WORKBENCH_ENABLED
+    NSString *name = NSBundle.mainBundle.infoDictionary[@"CFBundleDisplayName"] ?: @"FileDeck";
+    NSDictionary *attributes = @{NSFontAttributeName:[NSFont systemFontOfSize:16 weight:NSFontWeightSemibold],
+                                 NSForegroundColorAttributeName:dark ? NSColor.whiteColor : NSColor.labelColor};
+    NSSize size = [name sizeWithAttributes:attributes];
+    return [NSImage imageWithSize:NSMakeSize(90, 24) flipped:NO drawingHandler:^BOOL(NSRect rect) {
+        [name drawAtPoint:NSMakePoint((NSWidth(rect) - size.width) / 2, (NSHeight(rect) - size.height) / 2)
+          withAttributes:attributes];
+        return YES;
+    }];
+#else
+    return [NSImage imageNamed:dark ? @"logo-tab-light" : @"logo-tab-dark"];
+#endif
+}
